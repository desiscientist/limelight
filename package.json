{
  "name": "limelight",
  "version": "1.0.0",
  "private": true,
  "description": "Limelight: a full-stack video streaming platform (Node.js, Express, FFmpeg, HLS).",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "placeholders": "node --env-file-if-exists=.env scripts/placeholders.js",
    "placeholders:remove": "node --env-file-if-exists=.env scripts/placeholders.js remove",
    "placeholders:retag": "node --env-file-if-exists=.env scripts/placeholders.js retag"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.22.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "multer": "^2.5.0",
    "nodemailer": "^6.10.1"
  }
}
