# Password for the /admin upload page (only you should know this)
ADMIN_PASSWORD=change-me-to-something-long
# Name shown at the top of the site
SITE_NAME=Limelight
PORT=3001
# Max upload size in MB
MAX_UPLOAD_MB=4096
# Set to 1 when running behind a reverse proxy / HTTPS host (Render, Railway, nginx)
# TRUST_PROXY=1

# Optional: send password-reset emails (example for Gmail: smtp.gmail.com, port 465, and an App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=Limelight <you@gmail.com>
# Your site's public address, used in reset links (e.g. https://videos.example.com)
# PUBLIC_URL=

# Optional: real movie and TV pictures for placeholder videos (npm run placeholders).
# Free key for personal projects: themoviedb.org -> Settings -> API. Either the API Key or the Read Access Token works.
# TMDB_API_KEY=
